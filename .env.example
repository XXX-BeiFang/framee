# ============================================================
# Framee — 环境变量示例
# ------------------------------------------------------------
# 用法：复制本文件为 .env.local 后按需修改。
#   cp .env.example .env.local
#
# 注意：所有 NEXT_PUBLIC_ 开头的变量会在【构建时】被内联进前端产物，
#       修改后必须重新构建（Vercel 上需要 Redeploy）才会生效。
#       非 NEXT_PUBLIC_ 的变量在服务端运行时读取。
# ============================================================


# ------------------------------------------------------------
# 【必填】访问密码
# ------------------------------------------------------------
# 全站密码门。不设置时，middleware 会把所有页面 307 重定向到 /warning，
# 站点实际不可用。部署前必须设置。
PASSWORD=change-me-please

# ------------------------------------------------------------
# 【可选】管理员账号（仅非 localstorage 模式使用）
# ------------------------------------------------------------
# 与 PASSWORD 配合使用。当某个用户登录时的用户名等于此值时，
# 该用户被识别为超管（owner）。
# localstorage 模式下无需设置。
USERNAME=admin


# ------------------------------------------------------------
# 站点信息
# ------------------------------------------------------------
# 站点名称，会出现在标题、PWA manifest 等处。默认值：Framee
NEXT_PUBLIC_SITE_NAME=Framee

# 站点公告，显示在首页顶部。留空则使用内置默认文案。
ANNOUNCEMENT=


# ------------------------------------------------------------
# 【必填】存储方式
# ------------------------------------------------------------
# 可选值：
#   localstorage —— 播放记录/收藏保存在浏览器本地。零配置，但换设备即丢失，
#                   且管理后台（/admin）不可用。适合个人单机自用。
#   upstash      —— 使用 Upstash Redis，支持多账户、跨设备同步、管理后台。
#                   Vercel 上唯一可用的多用户方案。
#   redis        —— 使用自建 Redis。仅 Docker 部署可用，Vercel 不支持。
# 默认值：localstorage
NEXT_PUBLIC_STORAGE_TYPE=localstorage


# ------------------------------------------------------------
# 存储连接串（按上面选择的模式二选一填写）
# ------------------------------------------------------------
# 模式 redis 时填写，例如 redis://127.0.0.1:6379
REDIS_URL=

# 模式 upstash 时填写（在 Upstash 控制台复制 HTTPS Endpoint 与 Token）
UPSTASH_URL=
UPSTASH_TOKEN=


# ------------------------------------------------------------
# 用户自助注册（默认关闭）
# ------------------------------------------------------------
# 设为 true 后，登录页会出现「立即注册」入口，访客可自行创建账号。
#
# 前提：必须使用 upstash 或 redis 存储模式。localstorage 模式下没有服务端
#       用户体系，注册接口会返回 400。
#
# 通过注册创建的账号角色固定为 user，无法借此获得管理员权限。
# 每 IP 每小时最多成功注册 10 个账号（进程内存计数；多实例部署下为尽力而为，
# 如需真正的防护请配合 Vercel WAF 或 Upstash Ratelimit）。
#
# 默认值：（未设置）即关闭
NEXT_PUBLIC_ENABLE_REGISTRATION=


# ------------------------------------------------------------
# 搜索
# ------------------------------------------------------------
# 搜索接口单次可拉取的最大页数，取值 1-50。默认值：5
NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# 【搜索推荐功能必填】本站的完整访问地址，例如 https://framee.vercel.app
# 不填写时，「搜索页热门推荐」功能将不可用。
NEXT_PUBLIC_BASE_URL=


# ------------------------------------------------------------
# 豆瓣数据源
# ------------------------------------------------------------
# 请求豆瓣数据的方式。可选值：
#   direct                  —— 由服务器直接请求豆瓣源站（默认）
#   cors-proxy-zwei         —— 浏览器经第三方 CORS 代理请求
#   cmliussss-cdn-tencent   —— 浏览器请求豆瓣 CDN，腾讯云加速
#   cmliussss-cdn-ali       —— 浏览器请求豆瓣 CDN，阿里云加速
#   custom                  —— 使用下方 NEXT_PUBLIC_DOUBAN_PROXY 自定义地址
NEXT_PUBLIC_DOUBAN_PROXY_TYPE=direct

# 仅当上面填 custom 时生效，填写代理地址前缀
NEXT_PUBLIC_DOUBAN_PROXY=


# ------------------------------------------------------------
# 豆瓣图片代理
# ------------------------------------------------------------
# 图片加载方式。可选值：
#   direct                  —— 浏览器直连豆瓣图片域名
#   server                  —— 由本站服务器代理（/api/image-proxy）
#   img3                    —— 豆瓣官方精品 CDN（阿里云），默认
#   cmliussss-cdn-tencent   —— 豆瓣 CDN，腾讯云加速
#   cmliussss-cdn-ali       —— 豆瓣 CDN，阿里云加速
#   custom                  —— 使用下方 NEXT_PUBLIC_DOUBAN_IMAGE_PROXY 自定义地址
#
# 若出现图片大量加载失败，先尝试改为 direct 或 server。
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY_TYPE=img3

# 仅当上面填 custom 时生效，填写图片代理地址前缀
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY=
